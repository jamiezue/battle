{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siege-friends-arena",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ARENA_ROOM",
        "class_name": "ArenaRoomObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ArenaRoomObject"]
    }
  ],
  "vars": {
    "FRIENDS_CODE": "CHANGE-THIS-SECRET-CODE"
  }
}